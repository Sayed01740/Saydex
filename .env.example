# ==========================================
# Saydex Protocol — Environment Configuration
# ==========================================

# Port (Default: 3000)
PORT=3000

# Optional: Dedicated Web3 RPC Endpoints
# Public RPC endpoints are provided as default fallbacks.
# Provide dedicated API keys for high-volume rate limits.
VITE_INFURA_API_KEY=
VITE_ALCHEMY_API_KEY=
VITE_QUICKNODE_API_KEY=

# Optional: WalletConnect v2 Project ID (https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=
